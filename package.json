{
  "name": "@digitaplatform/translator",
  "version": "0.1.0",
  "type": "module",
  "description": "Built-in texts of the Digita platform and its services in every supported language, with the translator that reads them.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./*": {
      "types": "./dist/catalog/*.d.ts",
      "import": "./dist/catalog/*.js"
    }
  },
  "files": [
    "dist/src",
    "dist/catalog"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitaplatform/digita-translator.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc && node dist/tools/check.js && node dist/tools/build.js",
    "test": "node --test \"dist/tests/*.test.js\"",
    "check": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0"
}
